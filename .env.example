NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
# Production should use noreply@tornygolf.no once the Resend domain is verified.
RESEND_FROM_EMAIL=noreply@tornygolf.no

# Product-update digest (issue #202)
# CRON_SECRET: Vercel sends this as Bearer-token on /api/cron/* requests.
#   Sett til en lang random streng. Vercel-dashboardet eksponerer denne
#   automatisk når cron-jobben kjøres.
CRON_SECRET=
# PRODUCT_UPDATE_UNSUB_SECRET: HMAC-nøkkel for å signere unsub-tokens i
#   månedsbrev-mail. Bruk en lang random streng — rotering invaliderer
#   alle eksisterende mail-unsub-lenker.
PRODUCT_UPDATE_UNSUB_SECRET=

# Selv-registrering uten invitasjon (issue #166)
# NEXT_PUBLIC_ALLOW_SELF_REGISTRATION: når 'true' kan nye besøkende få
#   OTP-kode på /login uten å være forhåndsinvitert. Beskyttet av
#   honeypot + per-email/per-IP rate-limit. 'true' er prod-verdien.
#   Nødbryter ved misbruk: sett 'false' i Vercel og redeploy. Verdien
#   leses ved bygg (NEXT_PUBLIC_*), så en endring krever nytt bygg.
NEXT_PUBLIC_ALLOW_SELF_REGISTRATION=true

# Innlogging med Face ID / passkey (issue #63)
# NEXT_PUBLIC_PASSKEYS: off | admin | on. 'on' er prod-verdien: alle kan
#   legge til og logge inn med Face ID. 'admin' lar bare admin legge til.
#   Usatt eller ukjent verdi = 'off'. Nødbryter (Supabase Beta-API): sett
#   'off' i Vercel og redeploy. Verdien leses ved bygg, som flagget over.
NEXT_PUBLIC_PASSKEYS=on

# ANTHROPIC_API_KEY — nøkkel for AI-rundereferatet («Pressetribunen», #1008).
# Uten nøkkel hopper appen stille over referat-genereringen — resten av
# avslutt-flyten er upåvirket. Settes i Vercel av eieren når featuren skal på.
ANTHROPIC_API_KEY=

# App Store review-konto (issue #1284)
# REVIEW_ACCOUNT_EMAIL: adressen til den dedikerte App Review-kontoen.
#   Usatt (default) finnes ikke /review-login — sida svarer 404. Settes i
#   Vercel prod når kontoen provisjoneres; oppskrift og sikkerhetsmodell i
#   docs/native/app-store-review-konto.md. Passordet settes ALDRI i env —
#   det bor kun i Supabase (hashet) og i App Store Connect.
REVIEW_ACCOUNT_EMAIL=
