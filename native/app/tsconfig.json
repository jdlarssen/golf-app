{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 tar ikke lenger inn alt under node_modules/@types av seg selv,
    // så jest-globalene (describe/it/expect/jest) må navngis her. React- og
    // better-sqlite3-typene kommer inn via vanlige imports og trenger ingen rad.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["../../*"],
      // Speiler resolver.nodeModulesPaths i metro.config.js (#1869): delte
      // lib/-filer skal typesjekkes mot appens supabase-js, ikke rotas, så en
      // kjerne som tar en klient godtar appens klient uten cast. Hold dem i lås.
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  }
}
