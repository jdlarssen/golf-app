#!/usr/bin/env bash
# Håndhever bokførings-disiplinen beskrevet i CLAUDE.md "Versjonering / CHANGELOG".
#
# Fra #1562 rører en vanlig commit HVERKEN package.json ELLER CHANGELOG.md.
# Bruker-synlige commits legger i stedet igjen én notatfil under .changes/, og
# ukesrutinen (.github/workflows/ukesversjon.yml) folder dem til én versjon
# mandag morgen. To filer alle PR-er rørte var kilden til de faste
# rebase-konfliktene mellom parallelle økter.
#
# Slår ut på conventional-commit-prefiksene som signaliserer bruker-synlig endring:
#   feat(...) | fix(...) | perf(...)  → krever én ny fil under .changes/
#
# Skip-typer (notat-regelen ignorerer disse): docs, refactor, test, chore, style,
# ci, build. Bruk dem hvis commiten ikke endrer hva brukeren kan se eller gjøre.
#
# version-feltet eies av ukesrutinen og er sperret for alle andre commits.

set -e

msg_file="$1"
[ -z "$msg_file" ] && exit 0

msg="$(head -n 1 "$msg_file")"
body="$(cat "$msg_file")"

# Ignorer merge-, revert-, fixup-, squash-commits
case "$msg" in
  Merge\ *|Revert\ *|"fixup! "*|"squash! "*) exit 0 ;;
esac

# ─────────────────────────────────────────────────────────────────────
# H1 — version-vern: package.json sitt version-felt eies av ukesrutinen
# (chore(release)-commiten den lager). Alle andre commits skal la det stå.
# Gjelder ALLE prefikser, ikke bare de bruker-synlige: en «docs»-commit som
# drar med seg et bump lager nøyaktig den rebase-konflikten omleggingen fjernet.
# Actions kjører uten hooks, så unntaket her er for manuell re-kjøring lokalt.
# ─────────────────────────────────────────────────────────────────────
if ! printf '%s' "$msg" | grep -qE '^chore\(release\)!?: '; then
  # Sammenlign verdier, ikke bare «linja finnes»: et nytt package.json (ingen
  # gammel verdi) eller en urørt version-linje skal ikke slå ut.
  old_version="$(git diff --cached package.json | grep -E '^-  "version":' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
  new_version="$(git diff --cached package.json | grep -E '^\+  "version":' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
  if [ -n "$old_version" ] && [ -n "$new_version" ] && [ "$old_version" != "$new_version" ]; then
    printf '\n✗ Commit blokkert: version-feltet i package.json er ikke ditt å endre.\n\n' >&2
    printf '  Du endret %s → %s.\n' "$old_version" "$new_version" >&2
    printf '  Versjonen bumpes én gang i uka av ukesrutinen\n' >&2
    printf '  (.github/workflows/ukesversjon.yml → chore(release)-commiten).\n\n' >&2
    printf 'For å fortsette:\n' >&2
    printf '  1. git checkout -- package.json package-lock.json\n' >&2
    printf '  2. Legg endringen i en notatfil under .changes/ i stedet (se under)\n' >&2
    printf '  3. git commit (på nytt med samme melding)\n\n' >&2
    printf '  Reglene står i CLAUDE.md → "Versjonering / CHANGELOG".\n\n' >&2
    exit 1
  fi
fi

# ─────────────────────────────────────────────────────────────────────
# H2 — Issue-referanse (CLAUDE.md → "Branch + PR-flyt": «alle med Refs #N i body»).
# Alt backlog-arbeid spores i GitHub Issues, så feat/fix/perf/refactor MÅ peke
# på et issue i commit-body-en. Escape for ekte issue-løse endringer: skriv
# [no-issue] i body-en.
# ─────────────────────────────────────────────────────────────────────
if printf '%s' "$msg" | grep -qE '^(feat|fix|perf|refactor)(\([^)]+\))?!?: '; then
  if ! printf '%s' "$body" | grep -qE '(Refs|Closes|Fixes|Resolves) #[0-9]+' \
     && ! printf '%s' "$body" | grep -qF '[no-issue]'; then
    printf '\n✗ Commit blokkert: mangler issue-referanse i body.\n\n' >&2
    printf '  Alt backlog-arbeid spores i GitHub Issues. Legg til en body-linje:\n' >&2
    printf '    Refs #123      (eller Closes #123 på siste commit i en PR)\n\n' >&2
    printf '  Reglene står i CLAUDE.md → "Branch + PR-flyt".\n' >&2
    printf '  Ekte issue-løs endring (sjelden)? Skriv [no-issue] i body-en.\n\n' >&2
    exit 1
  fi
fi

# ─────────────────────────────────────────────────────────────────────
# H3 — Notatfil: bare for bruker-synlige commit-typer.
# Interne fikser (test-only, refactor-shipped-as-fix, tooling) hopper med
# [no-changelog], som før.
# ─────────────────────────────────────────────────────────────────────
if ! printf '%s' "$msg" | grep -qE '^(feat|fix|perf)(\([^)]+\))?!?: '; then
  exit 0
fi

if printf '%s' "$body" | grep -qF '[no-changelog]'; then
  exit 0
fi

# Kun NYE filer teller: en endring i et eksisterende notat er ikke en ny oppføring.
# README.md er malen, ikke et notat.
if git diff --cached --name-only --diff-filter=A \
   | grep -E '^\.changes/.+\.md$' \
   | grep -qvxF '.changes/README.md'; then
  exit 0
fi

prefix="$(printf '%s' "$msg" | grep -oE '^(feat|fix|perf)')"
printf '\n✗ Commit blokkert: mangler notatfil under .changes/\n\n' >&2
printf '  En bruker-synlig endring (%s) skal legge igjen én notatfil. Ukesrutinen\n' "$prefix" >&2
printf '  folder alle ukas notater til én versjon og skriver CHANGELOG-oppføringene\n' >&2
printf '  mandag morgen — derfor rører du hverken package.json eller CHANGELOG.md.\n\n' >&2
printf 'For å fortsette — lag .changes/<issue>-<slug>.md, f.eks.:\n\n' >&2
if [ "$prefix" = "feat" ]; then
  printf '  ---\n' >&2
  printf '  type: feat\n' >&2
  printf '  issue: 1463\n' >&2
  printf '  title: Cupene dine samlet på ett sted\n' >&2
  printf '  link: /admin/cup\n' >&2
  printf '  cta: Åpne cupene\n' >&2
  printf '  ---\n' >&2
  printf '  Cup-lista i Klubbhuset viser nå alle cupene du er med i.\n\n' >&2
else
  printf '  ---\n' >&2
  printf '  type: %s\n' "$prefix" >&2
  printf '  issue: 1539\n' >&2
  printf '  ---\n' >&2
  printf '  Best ball i en cup gir deg nå de slagene du skal ha.\n\n' >&2
fi
printf '  Deretter: git add .changes/<fila> && git commit (samme melding)\n\n' >&2
printf '  Full mal og feltgrenser: .changes/README.md\n' >&2
printf '  Stemme og format: docs/changelog-conventions.md\n\n' >&2
printf 'Er endringen IKKE bruker-synlig? Da har du to veier:\n' >&2
printf '  • skriv [no-changelog] i commit-body-en (intern fix som likevel shippes som fix), eller\n' >&2
printf '  • bytt prefix:\n' >&2
printf '      docs(...)     dokumentasjon\n' >&2
printf '      refactor(...) intern restrukturering\n' >&2
printf '      test(...)     test-endringer\n' >&2
printf '      chore(...)    tooling/config\n\n' >&2
exit 1
